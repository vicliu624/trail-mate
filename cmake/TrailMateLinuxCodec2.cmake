include_guard(GLOBAL)
function(trailmate_add_linux_codec2)
    if(TARGET trailmate_linux_codec2)
        return()
    endif()
    # Reuse the vendored minimal source ownership already used by PlatformIO.
    file(READ "${TRAIL_MATE_REPO_ROOT}/third_party/codec2/library.json" codec_manifest)
    string(JSON count LENGTH "${codec_manifest}" build srcFilter)
    math(EXPR last "${count} - 1")
    set(codec_sources "")
    foreach(index RANGE 0 ${last})
        string(JSON item GET "${codec_manifest}" build srcFilter ${index})
        if(item MATCHES "^\\+<([^>]+)>$")
            list(APPEND codec_sources "${TRAIL_MATE_REPO_ROOT}/third_party/codec2/src/${CMAKE_MATCH_1}")
        endif()
    endforeach()
    add_library(trailmate_linux_codec2 STATIC ${codec_sources})
    target_include_directories(trailmate_linux_codec2 PUBLIC "${TRAIL_MATE_REPO_ROOT}/third_party/codec2/src")
    target_link_libraries(trailmate_linux_codec2 PUBLIC m)
endfunction()
