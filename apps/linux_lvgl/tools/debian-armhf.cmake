set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR armv7l)
if(NOT DEFINED CMAKE_C_COMPILER)
    set(CMAKE_C_COMPILER arm-linux-gnueabihf-gcc)
endif()
if(NOT DEFINED CMAKE_CXX_COMPILER)
    set(CMAKE_CXX_COMPILER arm-linux-gnueabihf-g++)
endif()
if(NOT DEFINED ENV{TRAIL_MATE_SYSROOT})
    message(FATAL_ERROR "Set TRAIL_MATE_SYSROOT to the prepared Debian Trixie armhf root")
endif()
set(CMAKE_SYSROOT "$ENV{TRAIL_MATE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(TRAIL_MATE_DEBIAN_ARCH armhf CACHE STRING "Debian architecture")
set(TRAIL_MATE_TARGET_CXX_ABI_ROOT "$ENV{TRAIL_MATE_TARGET_CXX_ABI_ROOT}" CACHE PATH
    "Target-distribution C++ headers and link library overlay")
set(target_cxx_link_flags "")
if(TRAIL_MATE_TARGET_CXX_ABI_ROOT)
    file(GLOB target_cxx_versions LIST_DIRECTORIES TRUE
        "${TRAIL_MATE_TARGET_CXX_ABI_ROOT}/usr/include/c++/*")
    list(SORT target_cxx_versions COMPARE NATURAL ORDER DESCENDING)
    if(NOT target_cxx_versions)
        message(FATAL_ERROR "Target C++ ABI overlay has no versioned headers")
    endif()
    list(GET target_cxx_versions 0 target_cxx_include)
    get_filename_component(target_cxx_version "${target_cxx_include}" NAME)
    set(target_cxx_machine_include
        "${TRAIL_MATE_TARGET_CXX_ABI_ROOT}/usr/include/arm-linux-gnueabihf/c++/${target_cxx_version}")
    set(target_cxx_library_dir "${TRAIL_MATE_TARGET_CXX_ABI_ROOT}/usr/lib/arm-linux-gnueabihf")
    if(NOT EXISTS "${target_cxx_machine_include}/bits/c++config.h" OR
       NOT EXISTS "${target_cxx_library_dir}/libstdc++.so")
        message(FATAL_ERROR "Target C++ ABI overlay needs matching c++config.h and libstdc++.so")
    endif()
    set(CMAKE_CXX_FLAGS_INIT
        "-nostdinc++ -isystem \"${target_cxx_include}\" -isystem \"${target_cxx_machine_include}\"")
    set(target_cxx_link_flags "-L${target_cxx_library_dir} ")
    list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES TRAIL_MATE_TARGET_CXX_ABI_ROOT)
endif()
set(CMAKE_EXE_LINKER_FLAGS_INIT
    "${target_cxx_link_flags}-L${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf -L${CMAKE_SYSROOT}/usr/lib/gcc/arm-linux-gnueabihf/14 -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf")
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/arm-linux-gnueabihf/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")
