     struct mipi_dsi_device *dsi;
     struct gpio_desc *reset_gpio;
     struct gpio_desc *enable_gpio;
+    struct backlight_device *backlight;
+    struct mutex brightness_lock;
+    bool prepared;
+    bool enabled;
+    u8 applied_brightness;
+};
+
+static int amoled_panel_update_brightness(struct backlight_device *backlight)
+{
+    struct amoled_panel *p = bl_get_data(backlight);
+    u8 command[] = { 0x51, backlight_get_brightness(backlight) };
+    ssize_t ret = 0;
+
+    mutex_lock(&p->brightness_lock);
+    if (p->prepared && p->enabled) {
+        ret = mipi_dsi_dcs_write_buffer(p->dsi, command, sizeof(command));
+        /* VC4 reports successful completion as zero, rather than tx_len. */
+        if (ret == (ssize_t)sizeof(command) ||
+            (ret == 0 && p->dsi->host && p->dsi->host->dev &&
+             (of_device_is_compatible(p->dsi->host->dev->of_node, "brcm,bcm2835-dsi0") ||
+              of_device_is_compatible(p->dsi->host->dev->of_node, "brcm,bcm2835-dsi1"))))
+            p->applied_brightness = command[1];
+        else if (ret >= 0)
+            ret = -EIO;
+    }
+    mutex_unlock(&p->brightness_lock);
+    return ret < 0 ? ret : 0;
+}
+
+static int amoled_panel_get_brightness(struct backlight_device *backlight)
+{
+    struct amoled_panel *p = bl_get_data(backlight);
+    int brightness;
+
+    mutex_lock(&p->brightness_lock);
+    brightness = p->prepared && p->enabled ? p->applied_brightness : 0;
+    mutex_unlock(&p->brightness_lock);
+    return brightness;
+}
+
+static const struct backlight_ops amoled_panel_backlight_ops = {
+    .options = BL_CORE_SUSPENDRESUME,
+    .update_status = amoled_panel_update_brightness,
+    .get_brightness = amoled_panel_get_brightness,
 };
 
