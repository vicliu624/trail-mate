 static int amoled_panel_disable(struct drm_panel *panel)
 {
     struct amoled_panel *p = container_of(panel, struct amoled_panel, panel);
+    int ret = 0, sleep_ret;
 
     dev_info(&p->dsi->dev, "panel disable\n");
-    mipi_dsi_dcs_write_seq(p->dsi, 0x28);
-    msleep(20);
-    mipi_dsi_dcs_write_seq(p->dsi, 0x10);
-    msleep(80);
-    return 0;
+    mutex_lock(&p->brightness_lock);
+    if (p->enabled) {
+        p->enabled = false;
+        p->applied_brightness = 0;
+        ret = mipi_dsi_dcs_set_display_off(p->dsi);
+        msleep(20);
+        sleep_ret = mipi_dsi_dcs_enter_sleep_mode(p->dsi);
+        if (ret >= 0)
+            ret = sleep_ret;
+        msleep(80);
+    }
+    mutex_unlock(&p->brightness_lock);
+    return ret;
 }
 
