{
    "name":  "esp_arduino_common",
    "version":  "0.1.0",
    "frameworks":  [
                       "arduino"
                   ],
    "build":  {
                  "includeDir":  "include",
                  "srcDir":  "src",
                  "srcFilter":  [
                                    "+<*>",
                                    "-<ble/>",
                                    "-<hostlink/>",
                                    "-<rnode_kiss/>",
                                    "-<platform_ui_hostlink_runtime.cpp>",
                                    "-<ui/screens/gps/>"
                                ],
                  "flags":  [
                                "-I../../../platform/shared/include",
                                "-I../../../modules/ui_shared/include",
                                "-I../../../modules/ui_chat_runtime/include",
                                "-I../../../modules/ui_map_runtime/include",
                                "-I../../../modules/ui_gps_runtime/include",
                                "-I../../../modules/ui_lvgl_core/include",
                                "-I../../../modules/ui_lvgl_ux_packs/include",
                                "-I../../../modules/ui_mono/include",
                                "-I../../../modules/core_device/include",
                                "-I../../../modules/core_mesh/include",
                                "-I../../../modules/core_phone/include",
                                "-I../../../modules/core_sys/include",
                                "-I../../../modules/core_chat/include",
                                "-I../../../modules/core_gps/include",
                                "-I../../../modules/core_team/include",
                                "-I../../../modules/core_chat/generated",
                                "-I../../../modules/core_chat/third_party/nanopb",
                                "-I../../../platform/esp/common/include",
                                "-I../../../boards/tdeck_pro/include"
                            ]
              },
    "dependencies":  [
                         { "name": "core_geocaching" },
                         {
                             "name":  "esp_common"
                         },
                         {
                             "name":  "esp_boards"
                         },
                         {
                             "name":  "core_mesh"
                         },
                         {
                             "name":  "trail_mate_codec2"
                         },
                         {
                             "name":  "ui_map_runtime"
                         }
                     ]
}
